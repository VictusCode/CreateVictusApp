<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>VictusCode</Authors>
    <Copyright>Copyright © VictusCode 2025</Copyright>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)\VictusCode.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
</Project>
